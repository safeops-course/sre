# Terraform
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
*.auto.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc


# Kubeconfig written by Terraform (no credentials inside - exo signs a short-lived client certificate), and the
# new one make destroy writes before it replaces it, with the certificate authority it embeds
kubeconfig.yaml
kubeconfig.yaml.new
kubeconfig.ca.pem
