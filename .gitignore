tfplan
tfplan.meta
tfplan.meta.bak
*.tfplan
infra/terraform/kind_cluster/kubeconfig.yaml
site/content/course/
site/public/

# SOPS private keys (generated locally, never committed)
age.agekey
*.agekey
*.agekey.*.bak

# State lab: the second engineer's copy of infra/terraform/state-lab
infra/terraform/state-lab-b/
# gke-gcloud-auth-plugin caches its access token next to the kubeconfig - a credential
gke_gcloud_auth_plugin_cache
