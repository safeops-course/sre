# Copy this file to .env.azure and fill in your values. .env.azure is git-ignored - it names a tenant, a
# subscription and a person, and holds the Terraform state key.
#
# Used by: make -C infra/terraform/azure_foundation bootstrap | plan | apply | verify   (docs/azure.md)
#          make -C infra/terraform/aks_cluster plan | apply | destroy | leftovers

# ─── Azure identity ─────────────────────────────────────────────────────────
# The Azure CLI's directory: its sign-in and token cache. A directory of its own, never the default
# ~/.azure, which may be signed in to other tenants. Sign in with it set: AZURE_CONFIG_DIR=... az login
AZURE_CONFIG_DIR=/path/to/azure-cli-dir
# The subscription and its tenant - every call goes there (az account show --query '{sub:id, tenant:tenantId}').
TF_VAR_subscription_id=00000000-0000-0000-0000-000000000000
TF_VAR_tenant_id=00000000-0000-0000-0000-000000000000
# The person Terraform must run as - any other identity fails the plan; also the clusters' Kubernetes admin.
# az ad signed-in-user show --query id -o tsv
TF_VAR_expected_principal_object_id=00000000-0000-0000-0000-000000000000

# ─── Alerts ─────────────────────────────────────────────────────────────────
# Budget alerts go here.
TF_VAR_alert_email=you@example.com

# ─── Terraform state (Cloudflare R2) ────────────────────────────────────────
# The same R2 key as the other modules (bucket and endpoint in backend.tf).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── CNPG backups (infra/terraform/aks_cluster only) ────────────────────────
# Cloudflare R2: a bucket of its own (never the state bucket) and a key scoped to that bucket
# (Object Read & Write). The endpoint and region are in aks_cluster/terraform.tfvars. Required.
TF_VAR_backup_s3_bucket=
TF_VAR_backup_s3_access_key_id=
TF_VAR_backup_s3_secret_access_key=

# ─── The cluster's Flux (infra/terraform/aks_cluster only) ──────────────────
# The platform's age key, the one flux/secrets/** is encrypted for; Terraform reads the file on every
# run and sends the key to the cluster write-only (never in the plan or the state). No default: make
# checks that its public key is a recipient in .sops.yaml.
SOPS_AGE_KEY_FILE=/path/to/platform.agekey
# Uptrace DSN the OpenTelemetry collectors send logs, traces and metrics to - required (Uptrace Cloud has
# a free plan: https://uptrace.dev -> project -> DSN). The value as it is: no quotes, no name in front.
TF_VAR_uptrace_dsn=
# Azure kubelogin (github.com/Azure/kubelogin) - kubectl and Terraform get the cluster's Entra token from it.
# A full path when another `kubelogin` comes first in PATH (Homebrew's kubelogin is int128's OIDC plugin,
# a different tool): az aks install-cli --kubelogin-install-location <dir>/kubelogin
AZURE_KUBELOGIN=kubelogin
