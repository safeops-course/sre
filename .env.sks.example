# Copy this file to .env.sks and fill in your values. .env.sks is git-ignored - it names an organization and
# holds the Terraform state key. The Exoscale API key is NOT here: it stays in exo's own config file.
#
# Used by: make -C infra/terraform/sks_cluster plan | apply | destroy | leftovers   (docs/exoscale.md)

# ─── Exoscale identity ──────────────────────────────────────────────────────
# exo's config file, with the API key in its default account - a file of its own, never exo's default one,
# which may hold other organizations. Sign in with it set: EXOSCALE_CONFIG=... exo config add
# A full path: it is written into kubeconfig.yaml, so kubectl's exo reads the same file.
EXOSCALE_CONFIG=/path/to/exoscale/exoscale.toml
# The organization the key must belong to - any other fails the plan. Its default security group's id:
# exo compute security-group show default -O json | jq -r .id
TF_VAR_expected_default_security_group_id=00000000-0000-0000-0000-000000000000
# exo (github.com/exoscale/cli) - kubectl and Terraform get the cluster's client certificate from it. A full
# path when it is not in PATH.
EXO=exo

# ─── Terraform state (Cloudflare R2) ────────────────────────────────────────
# The same R2 key as the other modules (bucket and endpoint in backend.tf).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── CNPG backups ───────────────────────────────────────────────────────────
# Cloudflare R2: a bucket of its own (never the state bucket) and a key scoped to that bucket
# (Object Read & Write). The endpoint and region are in sks_cluster/terraform.tfvars. Required.
TF_VAR_backup_s3_bucket=
TF_VAR_backup_s3_access_key_id=
TF_VAR_backup_s3_secret_access_key=

# ─── The cluster's Flux ─────────────────────────────────────────────────────
# The platform's age key, the one flux/secrets/** is encrypted for; Terraform reads the file on every
# run and sends the key to the cluster write-only (never in the plan or the state). No default: make
# checks that its public key is a recipient in .sops.yaml.
SOPS_AGE_KEY_FILE=/path/to/platform.agekey
# Uptrace DSN the OpenTelemetry collectors send logs, traces and metrics to - required (Uptrace Cloud has
# a free plan: https://uptrace.dev -> project -> DSN). The value as it is: no quotes, no name in front.
TF_VAR_uptrace_dsn=
