# Example encrypted secret for production environment
# This is a PLAINTEXT example - DO NOT use as-is!
#
# ⚠️ PRODUCTION SECRETS REQUIRE EXTRA CARE:
# - Use strong, randomly generated passwords
# - Never reuse passwords from dev/staging
# - Consider using a separate age key for production
# - Backup age private key securely
# - Implement key rotation policy
#
# To create your own encrypted secret:
# 1. Copy this file: cp backend-secrets.yaml.example backend-secrets.yaml
# 2. Edit with SOPS: sops backend-secrets.yaml
# 3. Update values with STRONG production secrets
# 4. Save - SOPS will automatically encrypt
# 5. Commit: git add backend-secrets.yaml && git commit && git push

apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: production
type: Opaque
stringData:
  # JWT signing (backend)
  jwt-secret: "PRODUCTION-JWT-SECRET-USE-STRONG-RANDOM-STRING"

  # Uptrace ingest DSN (backend and frontend; ingest-only, the browser sees it)
  uptrace-dsn: "https://<token>@api.uptrace.dev?grpc=4317"
