apiVersion: v1
kind: Secret
metadata:
  name: k8s-ai-monitor-secrets
  namespace: observability
type: Opaque
stringData:
  # LLM
  openai-api-key: "replace-me"
  anthropic-api-key: "replace-me"

  # Notification destination.
  # Can be Slack webhook OR OpsGenie bridge webhook.
  slack-webhook-url: "replace-me"
  slack-webhook-url-nonprod: "replace-me"

  # Optional auth token for write endpoints.
  internal-token: "replace-me"

  # Optional centralized log backend (used by k8s-ai-monitor log search).
  elasticsearch-url: "https://replace-me:9200"
  elasticsearch-user: "elastic"
  elasticsearch-password: "replace-me"
