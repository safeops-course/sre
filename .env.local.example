# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.
#
# Usage: source ./load-env.sh

# ─── SOPS / Age ─────────────────────────────────────────────────────────────
# Private key for decrypting SOPS-encrypted Kubernetes secrets.
# Generate with: age-keygen -o ~/.ssh/age.agekey
SOPS_AGE_KEY=AGE-SECRET-KEY-...

# ─── Hetzner Cloud ──────────────────────────────────────────────────────────
# API token for Terraform to manage the k3s cluster.
# Create at: https://console.hetzner.cloud → project → Security → API Tokens
HCLOUD_TOKEN=

# ─── Cloudflare R2 (Terraform state only) ──────────────────────────────────
# S3-compatible credentials for the remote state (bucket and endpoint are in
# infra/terraform/hcloud_cluster/backend.tf). The state holds secrets - this key
# never goes into the cluster.
# Create at: Cloudflare dashboard → R2 → Manage R2 API Tokens (Object Read & Write, bucket sre)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── Cloudflare R2: the backup bucket (CNPG + etcd backups) ────────────────
# A separate key that lives in the cluster (Secret cnpg-backup-s3, etcd snapshot config): an R2 API
# token limited to the backup bucket, never the state bucket's. Create at: Cloudflare dashboard → R2 →
# Manage API tokens (Object Read & Write, that one bucket). The same target as every provider.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=

# ─── Cloudflare API (DNS + certificates) ───────────────────────────────────
# Token for external-dns and cert-manager DNS-01 challenges.
# Create at: Cloudflare dashboard → My Profile → API Tokens
# Permissions needed: Zone:DNS:Edit, Zone:Zone:Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ─── GitHub (Flux GitOps + image automation) ────────────────────────────────
# Personal Access Token for Flux to push image tag updates.
# Create at: GitHub → Settings → Developer settings → Personal access tokens
# Scope needed: Contents:Write on the sre repo
FLUX_GIT_TOKEN=github_pat_...

# ─── GitHub Container Registry (GHCR) ──────────────────────────────────────
# Credentials for pulling container images from GHCR.
# GHCR_TOKEN: PAT with read:packages scope
# Create at: GitHub → Settings → Developer settings → Personal access tokens
GHCR_USERNAME=your-github-username
GHCR_TOKEN=ghp_...

# ─── Uptrace (required on Hetzner) ─────────────────────────────────────────
# Uptrace Cloud DSN the OpenTelemetry collectors send logs, traces and metrics to. The Hetzner plan fails
# without it; on kind the collectors print to their own log instead. Sign up at https://uptrace.dev (free plan) -> project -> DSN.
UPTRACE_DSN=https://<token>@api.uptrace.dev?grpc=4317
