# Copy this file to .env.doks and fill in your values. .env.doks is git-ignored - it names an account and
# holds the Terraform state key. The DigitalOcean token is NOT here: it stays in doctl's own config file.
#
# Used by: make -C infra/terraform/doks_cluster plan | apply | destroy | leftovers   (docs/digitalocean.md)

# ─── DigitalOcean identity ──────────────────────────────────────────────────
# doctl's config file, with the token in its "default" context - a file of its own, never doctl's default
# one, which may hold other accounts. Sign in with it set: DIGITALOCEAN_CONFIG=... doctl auth init
# A full path: it is written into kubeconfig.yaml, so kubectl's doctl reads the same file.
DIGITALOCEAN_CONFIG=/path/to/doctl/config.yaml
# The user the token must belong to - any other account fails the plan: doctl account get --format UUID (40 hex characters)
TF_VAR_expected_account_uuid=0000000000000000000000000000000000000000
# doctl (github.com/digitalocean/doctl) - kubectl and Terraform get the cluster's token from it. A full path
# when it is not in PATH.
DOCTL=doctl

# ─── Terraform state (Cloudflare R2) ────────────────────────────────────────
# The same R2 key as the other modules (bucket and endpoint in backend.tf).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── CNPG backups ───────────────────────────────────────────────────────────
# Cloudflare R2: a bucket of its own (never the state bucket) and a key scoped to that bucket
# (Object Read & Write). The endpoint and region are in doks_cluster/terraform.tfvars. Required.
TF_VAR_backup_s3_bucket=
TF_VAR_backup_s3_access_key_id=
TF_VAR_backup_s3_secret_access_key=

# ─── The cluster's Flux ─────────────────────────────────────────────────────
# The platform's age key, the one flux/secrets/** is encrypted for; Terraform reads the file on every
# run and sends the key to the cluster write-only (never in the plan or the state). No default: make
# checks that its public key is a recipient in .sops.yaml.
SOPS_AGE_KEY_FILE=/path/to/platform.agekey
# Uptrace DSN the OpenTelemetry collectors send logs, traces and metrics to - required (Uptrace Cloud has
# a free plan: https://uptrace.dev -> project -> DSN). The value as it is: no quotes, no name in front.
TF_VAR_uptrace_dsn=
