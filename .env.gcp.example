# Copy this file to .env.gcp and fill in your values. .env.gcp is git-ignored - it names a person and a
# billing account, and holds the Terraform state key.
#
# Used by: make -C infra/terraform/gcp_foundation bootstrap | plan | apply | verify   (docs/gcp.md)
#          make -C infra/terraform/gke_cluster plan | apply | destroy

# ─── Google identity ────────────────────────────────────────────────────────
# The account Terraform must run as - any other identity fails the plan (main.tf, identity check).
TF_VAR_expected_principal=you@example.com
# The Application Default Credentials file of that account (gcloud auth application-default login).
# Name it explicitly when your workstation holds other Google identities: the google Terraform
# provider reads this variable or gcloud's default directory, never a CLOUDSDK_CONFIG directory.
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/gcloud/application_default_credentials.json

# ─── Billing and alerts ─────────────────────────────────────────────────────
# gcloud billing projects describe PROJECT_ID --format='value(billingAccountName)'
TF_VAR_billing_account_id=XXXXXX-XXXXXX-XXXXXX
# Budget and platform alerts go here.
TF_VAR_alert_email=you@example.com

# ─── Terraform state (Cloudflare R2) ────────────────────────────────────────
# The same R2 key as the Hetzner cluster (bucket and endpoint in backend.tf).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── CNPG backups (infra/terraform/gke_cluster only) ────────────────────────
# Cloudflare R2: a bucket of its own (never the state bucket) and a key scoped to that bucket
# (Object Read & Write). The endpoint and region are in gke_cluster/terraform.tfvars. Required.
TF_VAR_backup_s3_bucket=
TF_VAR_backup_s3_access_key_id=
TF_VAR_backup_s3_secret_access_key=

# ─── The cluster's Flux (infra/terraform/gke_cluster only) ──────────────────
# The platform's age key, the one flux/secrets/** is encrypted for; Terraform reads the file on every
# run and sends the key to the cluster write-only (never in the plan or the state). No default: make
# checks that its public key is a recipient in .sops.yaml.
SOPS_AGE_KEY_FILE=/path/to/platform.agekey
# Uptrace DSN the OpenTelemetry collectors send logs, traces and metrics to - required (Uptrace Cloud has
# a free plan: https://uptrace.dev -> project -> DSN).
TF_VAR_uptrace_dsn=
