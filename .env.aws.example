# Copy this file to .env.aws and fill in your values. .env.aws is git-ignored - it names an account and a
# person, and holds the Terraform state key.
#
# Used by: make -C infra/terraform/aws_foundation bootstrap | plan | apply | verify   (docs/aws.md)
#          make -C infra/terraform/eks_cluster plan | apply | destroy | leftovers

# ─── AWS identity ───────────────────────────────────────────────────────────
# The account - the provider refuses every other one.
TF_VAR_account_id=111122223333
# The AWS CLI profile Terraform signs in with: `aws login --profile <name>` (docs/aws.md, step 2).
# Short-lived credentials, no access key.
TF_VAR_aws_profile=platform
# The identity Terraform must run as - any other fails the plan (main.tf, identity check).
# aws sts get-caller-identity --profile <name> --query Arn
TF_VAR_expected_principal_arn=arn:aws:iam::111122223333:user/you

# ─── Alerts ─────────────────────────────────────────────────────────────────
# Budget alerts go here.
TF_VAR_alert_email=you@example.com

# ─── Terraform state (Cloudflare R2) ────────────────────────────────────────
# The same R2 key as the other modules (bucket and endpoint in backend.tf).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── CNPG backups (infra/terraform/eks_cluster only) ────────────────────────
# Cloudflare R2: a bucket of its own (never the state bucket) and a key scoped to that bucket
# (Object Read & Write). The endpoint and region are in eks_cluster/terraform.tfvars. Required.
TF_VAR_backup_s3_bucket=
TF_VAR_backup_s3_access_key_id=
TF_VAR_backup_s3_secret_access_key=

# ─── The cluster's Flux (infra/terraform/eks_cluster only) ──────────────────
# The platform's age key, the one flux/secrets/** is encrypted for; Terraform reads the file on every
# run and sends the key to the cluster write-only (never in the plan or the state). No default: make
# checks that its public key is a recipient in .sops.yaml.
SOPS_AGE_KEY_FILE=/path/to/platform.agekey
# Uptrace DSN the OpenTelemetry collectors send logs, traces and metrics to - required (Uptrace Cloud has
# a free plan: https://uptrace.dev -> project -> DSN). The value as it is: no quotes, no name in front.
TF_VAR_uptrace_dsn=
